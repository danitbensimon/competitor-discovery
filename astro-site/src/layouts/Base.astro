---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7JQB8CKVMT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7JQB8CKVMT');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: #FBF5EE; color: #1B1712; font-family: 'Manrope', sans-serif; -webkit-font-smoothing: antialiased; }
      a { color: #4B3BFF; text-decoration: none; }
      a:hover { color: #3324D6; }
      ::selection { background: #DED9FF; color: #1B1712; }
      :focus-visible { outline: 2px solid #4B3BFF; outline-offset: 2px; border-radius: 6px; }
      button, a, summary, input, [role=button] { cursor: pointer; }
      html { scroll-behavior: smooth; }
      @keyframes ciq-drift { 0% { transform: translate(0,0) scale(1); } 50% { transform: translate(3%,-3%) scale(1.06); } 100% { transform: translate(0,0) scale(1); } }
      @keyframes ciq-rowin { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
      @keyframes ciq-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
