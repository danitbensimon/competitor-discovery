  <!-- FOOTER -->
  <div style="background:#08080F; border-top:1px solid rgba(255,255,255,.07);">
    <div style="max-width:1200px; margin:0 auto; padding:28px 40px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;">
      <div style="display:flex; align-items:center; gap:10px;">
        <div style="width:24px; height:24px; border-radius:7px; background:linear-gradient(140deg,#4B3BFF,#8B5CF6);"></div>
        <span style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:15px; color:#fff;">CompetitorIQ</span>
