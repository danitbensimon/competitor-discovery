---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const files = import.meta.glob('../../data/competitors/*.json', { eager: true });
  return Object.values(files).map((data) => ({
    params: { slug: data.competitor.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const { competitor, companies, generated_at, company_count } = data;
const FREE_ROWS = 15;
const visible = companies.slice(0, FREE_ROWS);
const gatedCount = Math.max(company_count - FREE_ROWS, 0);
const updated = new Date(generated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

// HubSpot form — replaced by setup script / manually with real IDs
const HUBSPOT_PORTAL_ID = 'YOUR_PORTAL_ID';
const HUBSPOT_FORM_ID = 'YOUR_FORM_ID';
const hubspotAction = `https://forms.hubspot.com/uploads/form/v2/${HUBSPOT_PORTAL_ID}/${HUBSPOT_FORM_ID}`;

const title = `Companies using ${competitor.name} (${company_count}+ verified) — ${updated}`;
const description = `Browse ${company_count}+ companies that use ${competitor.name} (${competitor.domain}), found via public signals: case studies, reviews, job postings, tech-stack data and LinkedIn engagement. Updated ${updated}.`;

const faqs = [
  {
    q: `How do you know these companies use ${competitor.name}?`,
    a: `Every company on this list is backed by at least one public signal: a case study or customer page on ${competitor.domain}, a review on G2 or Capterra, a job posting requiring ${competitor.name} experience, tech-stack detection, or LinkedIn engagement with ${competitor.name} content. Each row shows its signal source.`,
  },
  {
    q: 'How fresh is this data?',
    a: `This list was last generated in ${updated}. We re-run our discovery pipeline regularly, so companies that switch away from ${competitor.name} are removed and new adopters are added.`,
  },
  {
    q: 'Can I download the full list?',
    a: `Yes — enter your work email above and you'll get the complete list of ${company_count}+ companies as a spreadsheet, including domains, industries, confidence grades and evidence links.`,
  },
  {
    q: `Why would I want a list of ${competitor.name} customers?`,
    a: `If you sell a competing or complementary product, companies already paying for ${competitor.name} have budget and an active need — they're the warmest accounts you can prospect.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />

  <p class="muted" style="margin-bottom:0">Updated {updated} · {company_count} companies · built from public signals</p>
  <h1>Companies using {competitor.name}</h1>
  <p>
    A verified list of companies that use <strong>{competitor.name}</strong> ({competitor.domain}),
    discovered through case studies, review sites, job postings, tech-stack data and LinkedIn engagement.
    The first {FREE_ROWS} are free — download the full list of {company_count}+ below.
  </p>

  <table>
    <thead>
      <tr><th>Company</th><th>Domain</th><th>Industry</th><th>Grade</th><th>Signal</th></tr>
    </thead>
    <tbody>
      {visible.map((c) => (
        <tr>
          <td><strong>{c.name}</strong></td>
          <td>{c.domain ? <a href={`https://${c.domain}`} rel="nofollow noopener" target="_blank">{c.domain}</a> : '—'}</td>
          <td>{c.industry || '—'}</td>
          <td class={`grade-${c.grade}`}>{c.grade}</td>
          <td class="muted">{(c.signal_groups || '').split(',')[0].replace(/_/g, ' ')}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="gate">
    <div class="fade"></div>
    <div class="gate-card" id="download">
      <h2 style="margin-top:0">Get all {company_count}+ companies using {competitor.name}</h2>
      <p class="muted">Full spreadsheet with domains, industries, confidence grades and evidence URLs. Free.</p>
      <form
        action={hubspotAction}
        method="POST"
        style="display:flex; gap:.6rem; justify-content:center; flex-wrap:wrap;"
      >
        <input type="email" name="email" placeholder="Work email" required />
        <input type="hidden" name="competitor" value={competitor.slug} />
        <button type="submit">Send me the list</button>
      </form>
      <p class="muted" style="font-size:.8rem">No spam. One email with the download link.</p>
    </div>
  </div>

  <h2>FAQ</h2>
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}

  <h2>Methodology</h2>
  <p>
    This list of {competitor.name} customers is generated by the open CompetitorIQ pipeline. It aggregates
    public signals — customer pages and case studies on {competitor.domain}, G2/Capterra reviews, job postings
    that require {competitor.name} experience, tech-stack databases, and LinkedIn engagement with {competitor.name}
    content — then deduplicates, grades (A = multiple strong signals, B = single signal) and scores each company.
    {gatedCount > 0 && ` ${gatedCount} additional companies are in the full download.`}
  </p>
</Base>
