  <style>
    @media (max-width: 900px) { .ciq-layout { grid-template-columns: 1fr !important; } .ciq-aside { position: static !important; } }
    .ciq-row:hover { background: #FBFAFF; }
  </style>

  <script type="application/json" id="ciq-data" set:html={ciqData} />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" defer></script>
  <script is:inline>
    (function(){
      var DATA = JSON.parse(document.getElementById('ciq-data').textContent);
      var q = document.getElementById('ciq-q');
      var rowsEl = document.getElementById('ciq-rows');
      var rows = [].slice.call(document.querySelectorAll('.ciq-row'));
      var empty = document.getElementById('ciq-empty');
      var shown = document.getElementById('ciq-shown');
      var arrow = document.getElementById('ciq-arrow');
      var grade = 'all', sortDir = 'asc';

      function apply(){
        var term = (q.value||'').trim().toLowerCase();
        var n = 0;
        rows.forEach(function(r){
          var okG = grade === 'all' || r.getAttribute('data-grade') === grade;
          var okQ = !term || r.getAttribute('data-search').indexOf(term) !== -1;
          var vis = okG && okQ;
          r.style.display = vis ? '' : 'none';
          if (vis) { r.style.animation = 'ciq-rowin .25s ease both'; n++; }
        });
        shown.textContent = n;
        empty.style.display = n ? 'none' : 'block';
      }
      function sort(){
        var sorted = rows.slice().sort(function(a,b){
          var x = a.getAttribute('data-company').toLowerCase(), y = b.getAttribute('data-company').toLowerCase();
          return sortDir === 'asc' ? x.localeCompare(y) : y.localeCompare(x);
        });
        sorted.forEach(function(r){ rowsEl.appendChild(r); });
      }

      q.addEventListener('input', apply);
      document.querySelectorAll('.ciq-tab').forEach(function(t){
        t.addEventListener('click', function(){
          grade = t.getAttribute('data-grade');
          document.querySelectorAll('.ciq-tab').forEach(function(x){ x.style.background='transparent'; x.style.color='#4A4A55'; });
          t.style.background='linear-gradient(135deg,#4B3BFF,#7C3AED)'; t.style.color='#fff';
          apply();
        });
      });
      document.getElementById('ciq-sort').addEventListener('click', function(){
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        arrow.textContent = sortDir === 'asc' ? '↑' : '↓';
        sort(); apply();
      });

      function visibleData(){
        var set = {};
        rows.forEach(function(r){ if (r.style.display !== 'none') set[r.getAttribute('data-company')] = true; });
        return DATA.companies.filter(function(c){ return set[c.name]; });
      }
      function doCsv(){
        var d = visibleData();
        var esc = function(v){ return '"' + String(v==null?'':v).replace(/"/g,'""') + '"'; };
        var head = ['Company','Domain','Grade','Confidence','Evidence','Source URL'];
        var body = d.map(function(c){ return [c.name,c.domain,c.grade,c.confidence,c.evidence,c.source_url].map(esc).join(','); });
        var csv = [head.join(','), body.join('\n')].join('\n');
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv'}));
        a.download = DATA.slug + '_customers.csv'; a.click(); URL.revokeObjectURL(a.href);
      }
      var GATE_KEY = 'ciqExcelEmail';
      var gate = document.getElementById('ciq-gate');
      var gateAction = 'xlsx';   // which download runs after a valid submit
      function openGate(action){
        // Always show the form. A stored email only prefills the field;
        // every download still goes through the gate.
        gateAction = action || 'xlsx';
        var isCsv = gateAction === 'csv';
        var badge = document.getElementById('ciq-gate-badge');
        var title = document.getElementById('ciq-gate-title');
        var submit = document.getElementById('ciq-gate-submit');
        if (badge) badge.textContent = isCsv ? '.CSV' : '.XLSX';
        if (title) title.textContent = isCsv ? 'Get the full list as CSV' : 'Get the full list as Excel';
        if (submit) submit.textContent = isCsv ? 'Download CSV →' : 'Download Excel →';
        gate.style.display = 'flex';
        var e = document.getElementById('ciq-email');
        var stored = null;
        try { stored = localStorage.getItem(GATE_KEY); } catch(_){}
        if (e && stored && !e.value) e.value = stored;
        setTimeout(function(){ if(e) e.focus(); }, 50);
      }
      document.getElementById('ciq-csv').addEventListener('click', function(){ openGate('csv'); });
      document.getElementById('ciq-xlsx').addEventListener('click', function(){ openGate('xlsx'); });
      var xlsxSide = document.getElementById('ciq-xlsx-side');
      if (xlsxSide) xlsxSide.addEventListener('click', function(){ openGate('xlsx'); });
      var xlsxBottom = document.getElementById('ciq-xlsx-bottom');
      if (xlsxBottom) xlsxBottom.addEventListener('click', function(){ openGate('xlsx'); });
      document.getElementById('ciq-gate-close').addEventListener('click', function(){ gate.style.display = 'none'; });
      gate.addEventListener('click', function(e){ if (e.target === gate) gate.style.display = 'none'; });
      document.getElementById('ciq-gate-submit').addEventListener('click', function(){
        var email = document.getElementById('ciq-email').value.trim();
        var linkedin = document.getElementById('ciq-linkedin').value.trim();
        var err = document.getElementById('ciq-gate-err');
        var errLi = document.getElementById('ciq-gate-err-li');
        var emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
        var liOk = /linkedin\.com\/[^\s]+/i.test(linkedin);
        err.style.display = emailOk ? 'none' : 'block';
        errLi.style.display = liOk ? 'none' : 'block';
        if (!emailOk || !liOk) return;
        if (!/^https?:\/\//i.test(linkedin)) linkedin = 'https://' + linkedin;
        try { localStorage.setItem(GATE_KEY, email); } catch(_){}
        try {
          fetch('https://api.hsforms.com/submissions/v3/integration/submit/147616801/1642d998-a0e2-493f-8e8b-2a6538736043', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ fields:[{name:'email', value:email},{name:'hs_linkedin_url', value:linkedin}], context:{ pageUri: location.href, pageName: document.title } })
          });
        } catch(_){}
        gate.style.display = 'none';
        if (gateAction === 'csv') { doCsv(); } else { doXlsx(); }
      });
      function doXlsx(){
        var url = '/downloads/' + DATA.slug + '_customers.xlsx';
        fetch(url, {method:'HEAD'}).then(function(res){
          if (res.ok) { var a=document.createElement('a'); a.href=url; a.download=DATA.slug+'_customers.xlsx'; document.body.appendChild(a); a.click(); a.remove(); }
          else { buildXlsx(); }
        }).catch(buildXlsx);
      }
      function buildXlsx(){
        if (typeof XLSX === 'undefined') return;
        var d = visibleData();
        var aoa = [['Company','Domain','Grade','Confidence','Evidence','Source URL']].concat(d.map(function(c){ return [c.name,c.domain,c.grade,c.confidence,c.evidence,c.source_url]; }));
        var ws = XLSX.utils.aoa_to_sheet(aoa); var wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Companies'); XLSX.writeFile(wb, DATA.slug + '_customers.xlsx');
      }
      sort();
    })();
  </script>
</Base>
