  <div id="ciq-gate" style="display:none; position:fixed; inset:0; z-index:99; background:rgba(11,11,18,.55); align-items:center; justify-content:center; padding:20px;">
    <div style="background:#fff; border-radius:18px; padding:28px 26px; max-width:400px; width:100%; box-shadow:0 40px 90px -30px rgba(11,11,18,.5);">
      <span id="ciq-gate-badge" style="display:inline-block; font-family:'JetBrains Mono',monospace; font-size:11px; color:#4B3BFF; background:#F2F1FF; border:1px solid #E3E0FF; border-radius:999px; padding:4px 11px;">.XLSX</span>
      <h3 id="ciq-gate-title" style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:20px; margin:14px 0 6px; color:#0B0B12;">Get the full list as Excel</h3>
      <p style="font-size:14px; color:#6A6A74; margin:0 0 16px; line-height:1.5;">Leave your work email and LinkedIn, and the formatted spreadsheet is yours: domains, grades, evidence and sources.</p>
      <input id="ciq-email" type="email" placeholder="you@company.com" style="width:100%; height:46px; border:1px solid #E6E6EC; border-radius:12px; padding:0 14px; font-size:15px; font-family:'Manrope',sans-serif; color:#0B0B12; outline:none;" />
      <input id="ciq-linkedin" type="url" placeholder="linkedin.com/in/your-profile" style="width:100%; height:46px; margin-top:10px; border:1px solid #E6E6EC; border-radius:12px; padding:0 14px; font-size:15px; font-family:'Manrope',sans-serif; color:#0B0B12; outline:none;" />
      <p id="ciq-gate-err" style="display:none; color:#D8422A; font-size:13px; margin:8px 0 0;">Please enter a valid email.</p>
      <p id="ciq-gate-err-li" style="display:none; color:#D8422A; font-size:13px; margin:8px 0 0;">Please enter your LinkedIn profile URL.</p>
      <button id="ciq-gate-submit" style="width:100%; height:48px; margin-top:12px; border:0; border-radius:12px; background:linear-gradient(135deg,#4B3BFF,#7C3AED); color:#fff; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:15px; cursor:pointer; box-shadow:0 14px 30px -14px rgba(75,59,255,.7);">Download Excel →</button>
      <button id="ciq-gate-close" style="width:100%; height:40px; margin-top:8px; border:0; background:transparent; color:#8A8A94; font-family:'Manrope',sans-serif; font-size:14px; cursor:pointer;">No thanks</button>
      <p style="font-size:12px; color:#9A9AA2; margin:10px 0 0; text-align:center;">No spam. One email with the download.</p>
    </div>
