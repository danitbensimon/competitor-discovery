---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const files = import.meta.glob('../../data/competitors/*.json', { eager: true });
  return Object.values(files).map((data) => ({
    params: { slug: data.competitor.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const { competitor, companies, generated_at, company_count } = data;
const updated = new Date(generated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const nA = companies.filter((c) => c.grade === 'A').length;
const nB = companies.filter((c) => c.grade === 'B').length;
const nC = companies.filter((c) => c.grade === 'C').length;
const notable = companies.filter((c) => c.grade === 'A').slice(0, 12).map((c) => c.name).join(', ');

// HubSpot form — replaced by setup script / manually with real IDs
const HUBSPOT_PORTAL_ID = 'YOUR_PORTAL_ID';
const HUBSPOT_FORM_ID = 'YOUR_FORM_ID';
const hubspotAction = `https://forms.hubspot.com/uploads/form/v2/${HUBSPOT_PORTAL_ID}/${HUBSPOT_FORM_ID}`;

const title = `Companies using ${competitor.name}: ${company_count} verified customers (${updated})`;
const description = `${company_count} named companies verified to use ${competitor.name} (${competitor.domain}), each with a public evidence source: case studies, customer blogs, partner case studies, job postings and reviews. Updated ${updated}.`;

const faqs = [
  {
    q: `How many companies use ${competitor.name}?`,
    a: `CompetitorIQ has verified ${company_count} named companies using ${competitor.name} as of ${updated}. Every company on this page is backed by a public, linked source; the vendor's total customer count is typically much larger.`,
  },
  {
    q: `How do you know these companies use ${competitor.name}?`,
    a: `Every row links to a public source: a case study on ${competitor.domain}, the company's own blog or trust page, an auditor or partner case study, a job posting requiring ${competitor.name} experience, or a named review. Rows are graded A (multiple independent signals), B (one direct piece of evidence) or C (technographic databases only).`,
  },
  {
    q: 'How fresh is this data?',
    a: `This list was last verified on ${updated}. The discovery pipeline re-runs regularly; companies that switch away are removed and new adopters are added.`,
  },
  {
    q: 'Can I download the full list?',
    a: `Yes — the full list is free on this page. Enter your work email to get it as a spreadsheet with domains, confidence grades and evidence links.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const datasetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Companies using ${competitor.name} — ${company_count} verified customers`,
  description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  dateModified: generated_at,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'CompetitorIQ', url: 'https://competitorcustomer.com' },
  keywords: [`${competitor.name} customers`, `companies using ${competitor.name}`, `${competitor.name} customer list`],
};
---
<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} slot="head" />

  <p class="muted" style="margin-bottom:0">Last verified {updated} · {company_count} named companies · every row has a public source · data license CC BY 4.0</p>
  <h1>Companies using {competitor.name}: {company_count} verified customers</h1>
  <p>
    A full, free list of companies verified to use <strong>{competitor.name}</strong> ({competitor.domain}).
    Unlike technographic databases, every company here is backed by a linked public source — case studies,
    customer blogs, partner and auditor case studies, job postings and named reviews. <strong>{nA} companies</strong>
    have multiple independent signals (grade A), {nB} have direct evidence (grade B), {nC} appear in
    technographic databases only (grade C).
  </p>
  <p><strong>Notable {competitor.name} customers:</strong> {notable}.</p>

  <p style="margin:1rem 0">
    <input type="search" id="filter" placeholder={`Filter ${company_count} companies…`} aria-label="Filter companies"
      style="padding:.6rem .9rem;border:1px solid var(--line);border-radius:8px;width:min(360px,100%);font-size:1rem" />
  </p>

  <div class="list-layout">
    <div class="list-main">
    <table id="companies">
    <thead>
      <tr><th>Company</th><th>Domain</th><th>Grade</th><th>Evidence</th><th>Source</th></tr>
    </thead>
    <tbody>
      {companies.map((c) => (
        <tr>
          <td><strong>{c.name}</strong></td>
          <td>{c.domain ? <a href={`https://${c.domain}`} rel="nofollow noopener" target="_blank">{c.domain}</a> : '—'}</td>
          <td class={`grade-${c.grade}`} title={c.confidence}>{c.grade}</td>
          <td class="muted evidence">{c.evidence}</td>
          <td>{c.source_url && c.source_url.startsWith('http') ? <a href={c.source_url} rel="noopener" target="_blank">source</a> : '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>

    </div><!-- .list-main -->
    <aside class="gate-aside">
      <div class="gate-card gate-side" id="download">
        <span class="gate-badge">⤓ .XLSX</span>
        <h2>Download the full list</h2>
        <p class="muted gate-sub">All {company_count} companies — domains, confidence grades, evidence quotes &amp; source links, ready to sort and filter.</p>
        <div id="ciq-form"><div class="hs-form-frame" data-region="eu1" data-form-id="1642d998-a0e2-493f-8e8b-2a6538736043" data-portal-id="147616801"></div></div>
        <div id="ciq-download" data-slug={competitor.slug} style="display:none;margin-top:1rem">
          <p style="font-weight:700;color:#34d399;margin:.4rem 0">✓ Thanks — your spreadsheet is downloading.</p>
          <button id="ciq-dl-again">↓ Download again (.xlsx)</button>
        </div>
        <p class="muted gate-fine">🔒 No spam. One email with the download link.</p>
      </div>
    </aside>
  </div><!-- .list-layout -->

  <h2>FAQ</h2>
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}

  <h2>Methodology</h2>
  <p>
    This list of {competitor.name} customers is generated by the CompetitorIQ deep-search pipeline across 12 signal
    groups: customer pages and case studies on {competitor.domain}, customer blogs and press releases, auditor and
    MSP partner case studies, vendor-hosted trust centers, job postings requiring {competitor.name} experience, named
    reviews, event speaker lists and technographic databases. Results are deduplicated and graded:
    <strong>A</strong> = multiple independent signals, <strong>B</strong> = one direct piece of evidence with a source link,
    <strong>C</strong> = technographic database detection only (treat with more caution). Known false positives are
    excluded. Found an error? <a href="mailto:hello@competitorcustomer.com">Report it</a> — corrections are published.
  </p>

  <style>
    .grade-C { color:#b45309; font-weight:700; }
    td.evidence { max-width:380px; font-size:.85rem; }
    #companies{border-collapse:separate;border-spacing:0;margin:1.25rem 0;background:#111a2e;border:1px solid #2b3a55;border-radius:12px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.45)}
    #companies thead th{background:#1b2a45;color:#dbe4f5;border-bottom:2px solid var(--brand);padding:.8rem .9rem;text-transform:uppercase;font-size:.72rem;letter-spacing:.06em;font-weight:700}
    #companies tbody td{padding:.7rem .9rem;border-bottom:1px solid #273449;vertical-align:top}
    #companies tbody tr:nth-child(even) td{background:rgba(255,255,255,.03)}
    #companies tbody tr:hover td{background:rgba(74,158,255,.12)}
    #companies tbody tr:last-child td{border-bottom:0}
    #companies td a{color:var(--brand2);font-weight:600}
    #companies td.grade-A,#companies td.grade-B,#companies td.grade-C{text-align:center;font-weight:800;font-size:1rem}
    #companies td.grade-C{color:#f87171}
    /* two-column: table + sticky sidebar download */
    .list-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:1.75rem;align-items:start;margin:1.25rem 0;}
    .list-main{min-width:0;}
    .list-main #companies{margin:0;}
    .list-main #companies{table-layout:fixed;width:100%;}
    #companies th:nth-child(1),#companies td:nth-child(1){width:19%;}
    #companies th:nth-child(2),#companies td:nth-child(2){width:19%;}
    #companies th:nth-child(3),#companies td:nth-child(3){width:8%;}
    #companies th:nth-child(4),#companies td:nth-child(4){width:46%;}
    #companies th:nth-child(5),#companies td:nth-child(5){width:8%;}
    #companies td:nth-child(2) a{word-break:break-word;}
    .gate-aside{position:sticky;top:1rem;}
    .gate-card.gate-side{padding:1.3rem 1.3rem 1.15rem;text-align:left;border-radius:16px;background:linear-gradient(180deg,#0f1a2e 0%,#0c1220 100%);border:1px solid #26344f;box-shadow:0 14px 34px rgba(0,0,0,.55);}
    .gate-badge{display:inline-block;font-size:.68rem;font-weight:800;letter-spacing:.06em;color:#7db8ff;background:rgba(74,158,255,.12);border:1px solid rgba(74,158,255,.35);padding:.24rem .6rem;border-radius:999px;margin-bottom:.65rem;}
    .gate-side h2{margin:.1rem 0 .35rem;font-size:1.12rem;line-height:1.25;}
    .gate-side .gate-sub{font-size:.83rem;line-height:1.55;margin:0 0 .95rem;}
    .gate-side .gate-fine{font-size:.72rem;margin:.75rem 0 0;opacity:.85;}
    .gate-side #ciq-dl-again{padding:.55rem 1rem;border:0;border-radius:8px;background:linear-gradient(90deg,#2f7fe8,#7db8ff);color:#fff;font-weight:700;cursor:pointer;width:100%;}
    /* compact + on-brand HubSpot embedded form */
    #ciq-form{min-height:150px;}
    #ciq-form input,#ciq-form select,#ciq-form textarea{font-size:.88rem !important;padding:.5rem .6rem !important;border-radius:8px !important;max-width:100% !important;box-sizing:border-box;}
    #ciq-form .hs-form-field,#ciq-form .hsfc-Field{margin-bottom:.55rem !important;}
    #ciq-form label,#ciq-form .hsfc-FieldLabel{font-size:.78rem !important;margin-bottom:.2rem !important;}
    #ciq-form .hs-richtext,#ciq-form .hsfc-RichText,#ciq-form .hsfc-Step__Title{display:none !important;}
    #ciq-form .hs-button,#ciq-form input[type=submit],#ciq-form .hsfc-Button{background:linear-gradient(90deg,#2f7fe8,#7db8ff) !important;border:0 !important;color:#fff !important;font-weight:700 !important;border-radius:8px !important;padding:.6rem 1rem !important;width:100% !important;cursor:pointer;}
    td.evidence{max-width:none;font-size:.82rem;}
    @media(max-width:860px){.list-layout{grid-template-columns:1fr;}.gate-aside{position:static;}.gate-card.gate-side{max-width:420px;}}
  </style>
  <script>
    const q = document.getElementById('filter');
    const rows = [...document.querySelectorAll('#companies tbody tr')];
    q.addEventListener('input', () => {
      const v = q.value.toLowerCase();
      rows.forEach((r) => { r.style.display = r.textContent.toLowerCase().includes(v) ? '' : 'none'; });
    });
  </script>
  <script is:inline src="https://js-eu1.hsforms.net/forms/embed/147616801.js" defer></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" defer></script>
  <script is:inline>
    (function(){
      function buildXlsx(){
        var dd=document.getElementById('ciq-download'); if(!dd||typeof XLSX==='undefined')return;
        var slug=dd.getAttribute('data-slug')||'competitor';
        var rows=[['Company','Domain','Grade','Evidence','Source URL']];
        document.querySelectorAll('#companies tbody tr').forEach(function(tr){
          var c=tr.querySelectorAll('td'); if(c.length<5)return;
          var a=c[4].querySelector('a'); var src=a?a.href:(c[4].innerText||'').trim();
          var dm=c[1].querySelector('a'); var dom=dm?dm.textContent.trim():(c[1].innerText||'').trim();
          rows.push([c[0].innerText.trim(),dom,c[2].innerText.trim(),c[3].innerText.trim(),src]);
        });
        var ws=XLSX.utils.aoa_to_sheet(rows); var wb=XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb,ws,'Companies'); XLSX.writeFile(wb,slug+'_customers.xlsx');
      }
      function doDownload(){
        var dd=document.getElementById('ciq-download'); if(!dd)return;
        var slug=dd.getAttribute('data-slug')||'competitor';
        var url='/downloads/'+slug+'_customers.xlsx';
        fetch(url,{method:'HEAD'}).then(function(r){
          if(r.ok){ var a=document.createElement('a'); a.href=url; a.download=slug+'_customers.xlsx'; document.body.appendChild(a); a.click(); a.remove(); }
          else { buildXlsx(); }
        }).catch(function(){ buildXlsx(); });
      }
      window.addEventListener('message',function(e){
        try{ if(e.data&&e.data.type==='hsFormCallback'&&(e.data.eventName==='onFormSubmitted'||e.data.eventName==='onFormSubmit')){
          var f=document.getElementById('ciq-form'),d=document.getElementById('ciq-download');
          if(f)f.style.display='none'; if(d)d.style.display='block'; setTimeout(doDownload,300);
        } }catch(_){}
      });
      document.addEventListener('click',function(e){ if(e.target&&e.target.id==='ciq-dl-again'){doDownload();} });
    })();
  </script>
</Base>
