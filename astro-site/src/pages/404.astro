---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found (404) — CompetitorIQ" description="The page you were looking for doesn't exist. Browse CompetitorIQ's verified customer lists instead.">
  <div style="text-align:center;padding:3.5rem 0 2rem">
    <p class="muted" style="font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;margin:0">Error 404</p>
    <h1 style="margin:.4rem 0 .6rem">This page doesn't exist</h1>
    <p class="muted" style="max-width:520px;margin:0 auto 1.6rem">The link may be broken or the page may have moved. Head back and explore our verified "companies using…" customer lists.</p>
    <p>
      <a href="/" style="display:inline-block;padding:.7rem 1.3rem;border-radius:10px;background:linear-gradient(90deg,#2f7fe8,#7db8ff);color:#fff;font-weight:700;text-decoration:none">← Back to CompetitorIQ</a>
    </p>
  </div>
</Base>
