---
// Site nav for blog pages; same look as the companies-using nav, 16px minimum.
---
<div class="snav">
  <div class="snav-in">
    <a href="/" class="snav-logo">
      <span class="snav-mark"><span></span></span>
      <span class="snav-name">CompetitorIQ</span>
    </a>
    <nav class="snav-links">
      <a href="/" class="snav-hide">All lists</a>
      <a href="/blog/" class="snav-hide">Blog</a>
      <a href="/#framework" class="snav-hide">How it works</a>
      <a href="https://meetings-eu1.hubspot.com/dben-simon" target="_blank" rel="noopener" class="snav-demo snav-hide">Book a demo</a>
      <a href="/#demo" class="snav-cta"><span class="snav-hide">Build your list free</span><span class="snav-short">Free list</span></a>
    </nav>
  </div>
</div>
<style>
  .snav { border-bottom:1px solid #EDEDF1; background:rgba(255,255,255,.75); backdrop-filter:blur(8px); position:sticky; top:0; z-index:20; }
  .snav-in { max-width:1200px; margin:0 auto; padding:18px 40px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
  .snav-logo { display:flex; align-items:center; gap:11px; }
  .snav-mark { width:30px; height:30px; border-radius:9px; background:linear-gradient(140deg,#4B3BFF,#8B5CF6); display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px -6px rgba(75,59,255,.7); }
  .snav-mark span { width:9px; height:9px; border-radius:2px; background:#fff; }
  .snav-name { font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:19px; letter-spacing:-0.02em; color:#0B0B12; }
  .snav-links { display:flex; align-items:center; gap:26px; }
  .snav-links a { font-size:16px; color:#33333C; font-weight:500; }
  .snav-links a.snav-demo { color:#4B3BFF; font-weight:600; }
  .snav-links a.snav-cta { height:42px; padding:0 18px; border-radius:11px; background:#0B0B12; color:#fff; font-family:'Space Grotesk',sans-serif; font-weight:600; display:inline-flex; align-items:center; white-space:nowrap; box-shadow:0 8px 20px -10px rgba(11,11,18,.6); }
  .snav-short { display:none; }
  @media (max-width: 860px) { .snav-in { padding:14px 16px; } .snav-hide { display:none; } .snav-short { display:inline; } }
</style>
